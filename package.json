{
  "name": "svyazka",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc -p packages/core --noEmit && tsc -p packages/engine --noEmit",
    "test": "vitest run",
    "validate": "tsx packages/core/src/validate-cli.ts",
    "check": "npm run typecheck && npm test && npm run validate -- examples/demo",
    "signals": "tsx packages/engine/src/signals-cli.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^5.1.0"
  }
}
